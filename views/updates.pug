doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="stylesheet", href="/css/style.css")

  body
    main.container.form-card
      h1 Add Anime Character
      p.subtitle Add a new character to your HubSpot CRM collection.

      form(action="/update-cobj", method="POST")
        .form-group
          label(for="name") Character Name
          input(
            type="text"
            id="name"
            name="name"
            placeholder="e.g. Gojo Satoru"
            maxlength="255"
            required
          )

        .form-group
          label(for="anime") Anime
          input(
            type="text"
            id="anime"
            name="anime"
            placeholder="e.g. Jujutsu Kaisen"
            maxlength="255"
            required
          )

        .form-group
          label(for="power") Power
          input(
            type="text"
            id="power"
            name="power"
            placeholder="e.g. Limitless"
            maxlength="255"
            required
          )

        .form-actions
          button(type="submit") Add Character
          a.btn.btn-secondary(href="/") Cancel
